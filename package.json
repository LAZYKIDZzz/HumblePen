{
  "name": "humblepen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev --host 127.0.0.1",
    "build": "node scripts/check-content.mjs && vitepress build",
    "preview": "vite preview --host 127.0.0.1 --outDir .vitepress/dist",
    "check": "node scripts/check-content.mjs",
    "check:site": "node scripts/check-site-output.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:server": "python3 tests/server-updater.py"
  },
  "devDependencies": {
    "markdown-it": "15.0.3",
    "minisearch": "7.2.0",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  },
  "overrides": {
    "vite": "6.4.5"
  },
  "description": "Turn reusable Q&A into a searchable Markdown knowledge base.",
  "license": "MIT"
}
